---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="404 — Hisyam Syafa Raditya"
  description="This page does not exist. The selected work does."
>
  <section class="wrap flex min-h-[70svh] flex-col justify-center py-20">
    <p class="mono-label">Error — 404</p>
    <h1 class="mt-6 max-w-[16ch] text-h1 font-[560]">
      This page doesn't exist. The work does.
    </h1>
    <p class="mt-6 max-w-[52ch] text-lead text-ink-2">
      The URL may be old or mistyped. Everything worth reading is one click away.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
      <a
        href="/#work"
        class="group inline-flex min-h-11 items-center gap-2 font-mono text-[12px] tracking-[0.14em] uppercase"
      >
        <span class="border-b border-rule-2 pb-0.5 transition-colors group-hover:border-accent group-hover:text-accent-2">
          Selected work
        </span>
        <Icon
          name="arrow-right"
          size={14}
          class="transition-transform duration-300 group-hover:translate-x-0.5 motion-reduce:transition-none"
        />
      </a>
      <a
        href="/"
        class="link-underline min-h-11 font-mono text-[12px] tracking-[0.14em] text-ink-2 uppercase"
      >
        Back home
      </a>
    </div>
  </section>
</BaseLayout>
