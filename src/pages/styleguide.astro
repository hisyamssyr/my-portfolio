---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ActionLink from "../components/ActionLink.astro";
import Icon from "../components/Icon.astro";
import { icons } from "../lib/icons";

const swatches = [
  { name: "--paper", light: "#F4F1EA", dark: "#121110", use: "Page background" },
  { name: "--paper-2", light: "#EBE7DC", dark: "#1B1A18", use: "Code blocks, quiet surfaces" },
  { name: "--ink", light: "#14130F", dark: "#EDE8DC", use: "Primary text (AA)" },
  { name: "--ink-2", light: "#56534A", dark: "#A8A294", use: "Secondary text (AA)" },
  { name: "--accent", light: "#E8431F", dark: "#FF6240", use: "Graphics, lines, large text" },
  { name: "--accent-2", light: "#BD330F", dark: "#FF6240", use: "Small text / links (AA)" },
  { name: "--rule", light: "rgba(20,19,15,.14)", dark: "rgba(237,232,220,.16)", use: "Hairlines" },
  { name: "--rule-2", light: "rgba(20,19,15,.34)", dark: "rgba(237,232,220,.40)", use: "Stronger lines" },
];

const iconNames = Object.keys(icons) as (keyof typeof icons)[];
---

<BaseLayout
  title="Styleguide — Hisyam Syafa Raditya"
  description="Internal design reference. Not indexed."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="wrap py-14">
    <SectionLabel index="00" text="Internal — Design Reference" />
    <h1 class="mt-6 text-h1 font-[560]">Styleguide</h1>
    <p class="mt-4 max-w-[62ch] text-lead text-ink-2">
      Direction: <em>Technical Editorial</em> — technical journal meets engineer's worksheet.
      Serif display, monospace metadata, visible hairline grid, one vermilion accent.
      Review this page before the remaining pages are built.
    </p>

    <!-- Typography -->
    <section class="mt-20" aria-labelledby="sg-type">
      <div class="border-b border-rule pb-3">
        <SectionLabel as="h2" index="01" text="Typography" class="text-ink!" />
      </div>

      <div class="grid gap-10 pt-8 lg:grid-cols-12">
        <p class="mono-label lg:col-span-2">Fraunces<br />Variable</p>
        <div class="lg:col-span-10">
          <p class="font-display text-display leading-[0.95] tracking-[-0.02em]">Display 01</p>
          <p class="mt-6 text-h2 font-[540]">Headline / h2 — a confident statement</p>
          <p class="mt-6 text-h3">Subhead / h3 for dense sections</p>
          <p class="mt-6 max-w-[68ch] text-lead">
            Lead paragraph — a single sentence that earns the next scroll. Serif reserved for
            display; body stays in a clean grotesque.
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-12">
        <p class="mono-label lg:col-span-2">Instrument Sans<br />Variable</p>
        <div class="lg:col-span-10">
          <p class="max-w-[68ch]">
            Body copy at 16–18px, line-height 1.65, measured at roughly 68 characters. Short
            sentences. Active verbs. Every claim traceable to the CV. <a href="#sg-type" class="link-underline">Inline links</a>
            use a hairline underline that turns vermilion on hover.
          </p>
          <p class="mt-4 text-small text-ink-2">Small / secondary text at 13px.</p>
        </div>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-12">
        <p class="mono-label lg:col-span-2">JetBrains Mono<br />Variable</p>
        <div class="lg:col-span-10 space-y-4">
          <p class="mono-label">01 — Selected work · 2026 · Surabaya, ID</p>
          <p>
            Inline metadata: <code class="border border-rule bg-paper-2 px-1.5 py-0.5 font-mono text-[13px]">Laravel 13 · Playwright · Docker</code>
          </p>
          <p><span class="todo-chip">TODO: add results</span></p>
        </div>
      </div>
    </section>

    <!-- Palette -->
    <section class="mt-20" aria-labelledby="sg-color">
      <div class="border-b border-rule pb-3">
        <SectionLabel as="h2" index="02" text="Palette" class="text-ink!" />
      </div>
      <p class="mt-6 max-w-[62ch]">
        Warm paper and ink; a single vermilion accent used sparingly — active links, markers,
        hover states, one hero element. All text pairs pass WCAG AA.
      </p>

      <div class="mt-8 grid gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-4">
        {
          swatches.map((swatch) => (
            <div class="bg-paper p-4">
              <div
                class="h-16 border border-rule"
                style={`background: var(${swatch.name});`}
              />
              <p class="mt-3 font-mono text-[11px] tracking-[0.08em]">{swatch.name}</p>
              <p class="mt-1 font-mono text-[11px] text-ink-2">
                L {swatch.light} · D {swatch.dark}
              </p>
              <p class="mt-2 text-small text-ink-2">{swatch.use}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div data-theme="light" class="border border-rule bg-paper p-6 text-ink">
          <p class="mono-label">Light — warm paper</p>
          <p class="mt-3 text-h3 font-[540]">Morning page</p>
          <p class="mt-2 max-w-[46ch] text-small">
            Ink on warm off-white, hairline rules at 14% opacity.
            <a href="#sg-color" class="link-underline">Accent link</a>.
          </p>
        </div>
        <div data-theme="dark" class="border border-rule bg-paper p-6 text-ink">
          <p class="mono-label">Dark — warm black</p>
          <p class="mt-3 text-h3 font-[540]">Night desk</p>
          <p class="mt-2 max-w-[46ch] text-small">
            Cream on near-black; the accent brightens to stay legible.
            <a href="#sg-color" class="link-underline">Accent link</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Components -->
    <section class="mt-20" aria-labelledby="sg-components">
      <div class="border-b border-rule pb-3">
        <SectionLabel as="h2" index="03" text="Components" class="text-ink!" />
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <ActionLink href="#sg-components" variant="solid" icon="arrow-up-right">Primary action</ActionLink>
        <ActionLink href="#sg-components" icon="file-down">Outline action</ActionLink>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-6 border-t border-rule pt-6">
        {
          iconNames.map((name) => (
            <span class="flex items-center gap-2 text-ink-2">
              <Icon name={name} size={18} />
              <span class="font-mono text-[11px]">{name}</span>
            </span>
          ))
        }
      </div>

      <div class="mt-8 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2">
        <div>
          <p class="mono-label mb-3">Rule / hairline</p>
          <div class="space-y-3">
            <div class="border-t border-rule"></div>
            <div class="border-t border-rule-2"></div>
            <div class="h-1 w-16 bg-accent"></div>
          </div>
        </div>
        <div>
          <p class="mono-label mb-3">Numbered section label</p>
          <SectionLabel index="01" text="Selected Work" />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
