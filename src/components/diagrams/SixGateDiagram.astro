---
const gates = [
  {
    id: 1,
    title: "Regression fails first",
    status: "documented",
    body: "The reported failure is reproduced in the sandbox before any patch is drafted. A fix cannot be verified against a bug that was never confirmed.",
  },
  {
    id: 2,
    title: "Patch passes tests",
    status: "documented",
    body: "The patched code has to make the failing tests pass inside the isolated Docker environment — no exceptions, no skipped cases.",
  },
  {
    id: 3,
    title: "Browser replay",
    status: "documented",
    body: "A scripted Playwright replay confirms the user-visible behavior end to end, not just the unit-level assertions.",
  },
  {
    id: 4,
    title: "TODO — gate 4",
    status: "todo",
    body: "TODO: the owner has not documented what this gate validates yet.",
  },
  {
    id: 5,
    title: "TODO — gate 5",
    status: "todo",
    body: "TODO: the owner has not documented what this gate validates yet.",
  },
  {
    id: 6,
    title: "TODO — gate 6",
    status: "todo",
    body: "TODO: the owner has not documented what this gate validates yet.",
  },
];
---

<div class="gate-diagram" data-gates>
  <div class="relative">
    <div class="gate-line" aria-hidden="true"></div>
    <div role="tablist" aria-label="Six-gate verification pipeline" class="relative grid grid-cols-3 gap-2 sm:grid-cols-6">
      {
        gates.map((gate, index) => (
          <button
            type="button"
            role="tab"
            id={`gate-tab-${gate.id}`}
            aria-controls={`gate-panel-${gate.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-active={index === 0 ? "true" : undefined}
            data-gate-tab
            class:list={["gate-node", gate.status === "todo" && "gate-node--todo"]}
          >
            <span class="gate-node__num">G{gate.id}</span>
            <span class="gate-node__label">{gate.status === "todo" ? "TODO" : gate.title}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="mt-4">
    {
      gates.map((gate, index) => (
        <div
          id={`gate-panel-${gate.id}`}
          role="tabpanel"
          aria-labelledby={`gate-tab-${gate.id}`}
          data-active={index === 0 ? "true" : undefined}
          data-gate-panel
          class="gate-panel border border-rule p-5"
        >
          <p class="mono-label">
            <span class="text-accent-2">G{gate.id}</span> — {gate.title}
          </p>
          <p class="mt-3 max-w-[62ch] text-small text-ink-2">{gate.body}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .gate-line {
    position: absolute;
    top: 1.55rem;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--rule);
  }

  @media (max-width: 639px) {
    .gate-line {
      display: none;
    }
  }

  .gate-node {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-top-width: 3px;
    border-top-color: var(--ink);
    padding: 0.7rem 0.8rem 0.8rem;
    text-align: left;
    min-height: 4.5rem;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .gate-node:hover {
    background: var(--paper-2);
  }

  .gate-node[data-active="true"],
  .gate-node:focus-visible {
    border-top-color: var(--accent);
  }

  .gate-node--todo {
    border-top-style: dashed;
    border-top-color: var(--accent);
    border-style: dashed;
  }

  .gate-node__num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }

  .gate-node[data-active="true"] .gate-node__num {
    color: var(--accent-2);
  }

  .gate-node__label {
    font-size: var(--text-small);
    line-height: 1.3;
    color: var(--ink);
  }

  .gate-node--todo .gate-node__label {
    color: var(--accent-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  :global(html.js) .gate-panel:not([data-active]) {
    display: none;
  }

  .gate-panel + .gate-panel {
    margin-top: 0.5rem;
  }
</style>

<script>
  function setupGates() {
    document.querySelectorAll<HTMLElement>("[data-gates]").forEach((diagram) => {
      if (diagram.dataset.bound === "true") return;
      diagram.dataset.bound = "true";

      const tabs = Array.from(diagram.querySelectorAll<HTMLButtonElement>("[data-gate-tab]"));
      const panels = Array.from(diagram.querySelectorAll<HTMLElement>("[data-gate-panel]"));

      function activate(tab: HTMLButtonElement, focus = false) {
        tabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute("aria-selected", active ? "true" : "false");
          item.tabIndex = active ? 0 : -1;
          if (active) item.dataset.active = "true";
          else delete item.dataset.active;
        });
        panels.forEach((panel) => {
          const active = panel.id === tab.getAttribute("aria-controls");
          if (active) panel.dataset.active = "true";
          else delete panel.dataset.active;
        });
        if (focus) tab.focus();
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(tab));
        tab.addEventListener("keydown", (event) => {
          let next: number | null = null;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
          if (event.key === "Home") next = 0;
          if (event.key === "End") next = tabs.length - 1;
          if (next === null) return;
          event.preventDefault();
          activate(tabs[next], true);
        });
      });
    });
  }

  setupGates();
  document.addEventListener("astro:page-load", setupGates);
</script>
