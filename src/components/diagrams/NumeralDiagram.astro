---
const classes = Array.from({ length: 15 }, (_, index) => String(index + 1).padStart(2, "0"));
---

<div>
  <div class="grid max-w-[34rem] grid-cols-5 gap-px border border-rule bg-rule" role="img" aria-label="Grid of the 15 numeral classes in the dataset">
    {
      classes.map((label) => (
        <div class="flex aspect-square flex-col justify-between bg-paper p-2">
          <span class="font-mono text-[10px] tracking-[0.1em] text-ink-2">{label}</span>
          <span class="self-end font-display text-h2 leading-none text-ink-2" aria-hidden="true">
            {Number(label)}
          </span>
        </div>
      ))
    }
  </div>
  <p class="mt-3 font-mono text-[11px] tracking-[0.06em] text-ink-2">
    15 classes · 10,500 images · 70 writers
  </p>

  <div class="mt-6 border border-dashed border-rule-2 p-5">
    <p class="mono-label"><span class="text-accent-2">Diagnostics</span> — Grad-CAM</p>
    <p class="mt-3 max-w-[62ch] text-small text-ink-2">
      Grad-CAM shows which strokes drive each prediction, per class and per error case.
      A before/after comparison slider ships once the owner provides the rendered images.
    </p>
    <p class="mt-3"><span class="todo-chip">TODO: add Grad-CAM images</span></p>
  </div>
</div>
