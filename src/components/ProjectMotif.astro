---
interface Props {
  variant: "six-gate" | "agents" | "numeral";
  class?: string;
}

const { variant, class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 240 140"
  class:list={["h-auto w-full", className]}
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
>
  {
    variant === "six-gate" && (
      <g>
        <line x1="16" y1="70" x2="224" y2="70" stroke="var(--rule-2)" stroke-width="1" />
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <g>
            <rect
              x={16 + i * 38}
              y="52"
              width="30"
              height="36"
              fill="var(--paper)"
              stroke={i < 3 ? "var(--ink)" : "var(--rule-2)"}
              stroke-width="1.5"
              stroke-dasharray={i < 3 ? undefined : "4 3"}
            />
            <line
              x1={16 + i * 38}
              y1="52"
              x2={46 + i * 38}
              y2="52"
              stroke={i < 3 ? "var(--accent)" : "var(--rule-2)"}
              stroke-width="3"
            />
            <text x={31 + i * 38} y="76" text-anchor="middle" font-size="10" fill="var(--ink-2)">
              G{i + 1}
            </text>
          </g>
        ))}
      </g>
    )
  }

  {
    variant === "agents" && (
      <g>
        <rect x="14" y="56" width="34" height="28" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="31" y="74" text-anchor="middle" font-size="10" fill="var(--ink-2)">IN</text>
        <line x1="48" y1="70" x2="72" y2="70" stroke="var(--rule-2)" stroke-width="1.5" />
        <rect x="72" y="56" width="34" height="28" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        <text x="89" y="74" text-anchor="middle" font-size="10" fill="var(--ink-2)">A</text>
        <line x1="106" y1="70" x2="128" y2="70" stroke="var(--rule-2)" stroke-width="1.5" />
        {[0, 1, 2].map((i) => (
          <rect x="128" y={30 + i * 27} width="34" height="20" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
        ))}
        <line x1="162" y1="70" x2="184" y2="70" stroke="var(--rule-2)" stroke-width="1.5" />
        <rect x="184" y="56" width="42" height="28" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />
        <text x="205" y="74" text-anchor="middle" font-size="10" fill="var(--accent-2)">REV</text>
      </g>
    )
  }

  {
    variant === "numeral" && (
      <g>
        {[0, 1, 2].map((row) =>
          [0, 1, 2, 3, 4].map((col) => (
            <rect
              x={38 + col * 34}
              y={28 + row * 32}
              width="22"
              height="22"
              fill="var(--paper)"
              stroke={row === 1 && col === 2 ? "var(--accent)" : "var(--ink-2)"}
              stroke-width="1.5"
            />
          ))
        )}
        <text x="120" y="132" text-anchor="middle" font-size="10" fill="var(--ink-2)">
          15 CLASSES
        </text>
      </g>
    )
  }
</svg>

<style>
  text {
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
  }
</style>
